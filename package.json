{
  "name": "RNTesting",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "clean": "cd ios && rm -rf build && cd .. && cd android && ./gradlew clean && cd ..",
    "clean:metro": "react-native start --reset-cache",
    "clean:jest": "jest --clearCache",
    "clean:all": "rm -rf node_modules && rm -rf ios/Pods && rm -rf ios/build && rm -rf android/build && rm -rf android/app/build && npm install && cd ios && pod install && cd ..",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:coverage:watch": "jest --coverage --watch",
    "build:e2e": "detox build --configuration ios.sim.release",
    "test:e2e": "detox test --configuration ios.sim.release",
    "build:e2e:debug": "detox build --configuration ios.sim.debug",
    "test:e2e:debug": "detox test --configuration ios.sim.debug"
  },
  "dependencies": {
    "@react-native-picker/picker": "^2.11.4",
    "@react-native/new-app-screen": "0.83.1",
    "react": "19.2.0",
    "react-native": "0.83.1",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "detox": "^20.47.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "jest-circus": "^30.2.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
